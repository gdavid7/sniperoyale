# Clash Royale Deck Tracker Configuration
# Copy this file to .env and customize as needed

# Application Settings
LOG_LEVEL=INFO
DETECTION_INTERVAL=2.0

# GUI Settings
WINDOW_WIDTH=800
WINDOW_HEIGHT=600
THEME=dark

# Screen Capture Settings
BLUESTACKS_WINDOW_TITLE=BlueStacks

# OCR Settings
TESSERACT_PATH=
# Example Windows: C:/Program Files/Tesseract-OCR/tesseract.exe
# Leave empty for default system installation

# API Settings (if using official RoyaleAPI in future)
ROYALE_API_KEY=
